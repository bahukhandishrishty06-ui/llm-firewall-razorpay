                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/firewall/process": {
      "post": {
        "summary": "Process Message Endpoint",
        "description": "Run a message through the complete Layer 1 \u2192 agent \u2192 Layer 2 pipeline.",
        "operationId": "process_message_endpoint_v1_firewall_process_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
