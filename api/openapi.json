                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/razorpay/payment-order": {
      "post": {
        "summary": "Create Razorpay Test Payment",
        "description": "Create a server-side Razorpay Test Mode order for a Checkout demonstration.",
        "operationId": "create_razorpay_test_payment_v1_demo_razorpay_payment_order_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTestPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
