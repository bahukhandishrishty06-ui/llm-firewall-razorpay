              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTestPaymentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/razorpay/payment-verify": {
      "post": {
        "summary": "Verify Razorpay Test Payment",
        "description": "Verify Checkout's signature and capture state before accepting a payment.",
        "operationId": "verify_razorpay_test_payment_v1_demo_razorpay_payment_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyTestPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
