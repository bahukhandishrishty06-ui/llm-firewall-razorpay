                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/refunds/request": {
      "post": {
        "summary": "Request Demo Refund",
        "description": "Create a refund review request; this does not contact Razorpay.",
        "operationId": "request_demo_refund_v1_demo_refunds_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRefundReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundRequestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/refunds/{request_id}/review": {
      "post": {
        "summary": "Review Demo Refund",
        "description": "Demo-only human-review step. Production must replace this with staff authentication.",
        "operationId": "review_demo_refund_v1_demo_refunds__request_id__review_post",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRefundRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundRequestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/demo/refunds/{request_id}/execute": {
      "post": {
        "summary": "Execute Demo Refund",
        "description": "The only route that can call Razorpay's Test Mode refund API.",
        "operationId": "execute_demo_refund_v1_demo_refunds__request_id__execute_post",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundRequestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/red-team/run": {
      "post": {
        "summary": "Run Red Team Challenge",
        "description": "Run curated adversarial prompts against the same Layer 1 guardrails.",
        "operationId": "run_red_team_challenge_v1_red_team_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedTeamRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedTeamRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/session/reset": {
      "post": {
        "summary": "Reset Session Endpoint",
        "operationId": "reset_session_endpoint_v1_session_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit/decisions": {
      "get": {
        "summary": "Firewall Decisions Endpoint",
        "operationId": "firewall_decisions_endpoint_v1_audit_decisions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 40,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Firewall Decisions Endpoint V1 Audit Decisions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit/actions": {
      "get": {
        "summary": "Audit Actions Endpoint",
        "operationId": "audit_actions_endpoint_v1_audit_actions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 40,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Audit Actions Endpoint V1 Audit Actions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evaluation/results": {
      "get": {
        "summary": "Evaluation Results Endpoint",
        "operationId": "evaluation_results_endpoint_v1_evaluation_results_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Evaluation Results Endpoint V1 Evaluation Results Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/telemetry/metrics": {
      "get": {
        "summary": "Telemetry Metrics Endpoint",
        "operationId": "telemetry_metrics_endpoint_v1_telemetry_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Telemetry Metrics Endpoint V1 Telemetry Metrics Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionScreenRequest": {
        "properties": {
          "tool_name": {
            "type": "string",
            "title": "Tool Name",
            "description": "Name of tool being called (e.g. issue_refund, apply_discount)"
          },
          "tool_args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tool Args",
            "description": "Arguments passed to the tool"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Active session ID for anomaly velocity tracking"
          }
        },
        "type": "object",
        "required": [
          "tool_name",
          "tool_args"
        ],
        "title": "ActionScreenRequest"
      },
      "ActionScreenResponse": {
        "properties": {
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "policy_violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Policy Violations"
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "confidence",
          "reason"
        ],
        "title": "ActionScreenResponse"
      },
      "CreateRefundReviewRequest": {
        "properties": {
          "local_order_id": {
            "type": "string",
            "title": "Local Order Id"
          },
          "amount_inr": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Amount Inr"
          },
          "evidence_summary": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Evidence Summary"
          }
        },
        "type": "object",
        "required": [
          "local_order_id",
          "amount_inr",
          "evidence_summary"
        ],
        "title": "CreateRefundReviewRequest"
      },
      "CreateTestPaymentRequest": {
        "properties": {
          "amount_inr": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Amount Inr",
            "default": 500
          },
          "customer_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer Id",
            "default": "CUST_101"
          }
        },
        "type": "object",
        "title": "CreateTestPaymentRequest"
      },
      "CreateTestPaymentResponse": {
        "properties": {
          "local_order_id": {
            "type": "string",
            "title": "Local Order Id"
          },
          "razorpay_order_id": {
            "type": "string",
            "title": "Razorpay Order Id"
          },
          "key_id": {
            "type": "string",
            "title": "Key Id"
          },
          "amount_paise": {
            "type": "integer",
            "title": "Amount Paise"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "local_order_id",
          "razorpay_order_id",
          "key_id",
          "amount_paise",
          "currency",
          "status"
        ],
        "title": "CreateTestPaymentResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "PaymentSessionResponse": {
        "properties": {
          "local_order_id": {
            "type": "string",
            "title": "Local Order Id"
          },
          "razorpay_order_id": {
            "type": "string",
            "title": "Razorpay Order Id"
          },
          "razorpay_payment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Razorpay Payment Id"
          },
          "amount_paise": {
            "type": "integer",
            "title": "Amount Paise"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          }
        },
        "type": "object",
        "required": [
          "local_order_id",
          "razorpay_order_id",
          "amount_paise",
          "status"
        ],
        "title": "PaymentSessionResponse"
      },
      "ProcessRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "Customer message to process through the complete firewall"
          },
          "use_llm": {
            "type": "boolean",
            "title": "Use Llm",
            "description": "Whether to use the semantic analysis layer",
            "default": false
          },
          "block_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Block Threshold",
            "default": 0.7
          },
          "flag_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Flag Threshold",
            "default": 0.4
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ProcessRequest"
      },
      "ProcessResponse": {
        "properties": {
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "layer": {
            "type": "string",
            "title": "Layer"
          },
          "agent_response": {
            "type": "string",
            "title": "Agent Response",
            "default": ""
          },
          "tool_calls_made": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Tool Calls Made"
          },
          "tool_calls_blocked": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Tool Calls Blocked"
          },
          "input_screening": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Screening"
          },
          "action_screenings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Action Screenings"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "confidence",
          "reason",
          "layer",
          "session_id",
          "timestamp"
        ],
        "title": "ProcessResponse"
      },
      "RazorpayTestConfigResponse": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "key_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "message"
        ],
        "title": "RazorpayTestConfigResponse"
      },
      "RedTeamCaseResult": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "payload": {
            "type": "string",
            "title": "Payload"
          },
          "expected_verdict": {
            "type": "string",
            "title": "Expected Verdict"
          },
          "verdict": {
            "type": "string",
            "title": "Verdict"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "layer": {
            "type": "string",
            "title": "Layer"
          },
          "heuristic_triggers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Heuristic Triggers"
          },
          "simulated_exposure_inr": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Simulated Exposure Inr",
            "default": 0
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "category",
          "payload",
          "expected_verdict",
          "verdict",
          "confidence",
          "reason",
          "layer",
          "passed"
        ],
        "title": "RedTeamCaseResult"
      },
      "RedTeamRunRequest": {
        "properties": {
          "use_llm": {
            "type": "boolean",
            "title": "Use Llm",
            "description": "Whether to add the semantic analysis layer",
            "default": false
          },
          "block_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Block Threshold",
            "default": 0.7
          },
          "flag_threshold": {
            "type": "number",
            "maximum": 1.0,
